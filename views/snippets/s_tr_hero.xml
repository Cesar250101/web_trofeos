<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="s_tr_hero" name="Trofeos Hero">
        <t t-set="tr_company" t-value="request.env.company.sudo()"/>
        <section class="s_tr_hero tr-hero" data-snippet="s_tr_hero">
            <div class="tr-hero-inner">
                <div class="tr-hero-text">
                    <div class="tr-hero-eyebrow">Importadores y distribuidores · desde 2008</div>
                    <h1 class="tr-hero-title">PREMIA<br/><span class="tr-gold-word">EL ESFUERZO.</span></h1>
                    <p class="tr-hero-sub">Trofeos, copas y medallas para clubes, empresas y eventos en todo Chile. Stock permanente. Despacho 24-72 h. Grabado láser propio.</p>
                    <div class="tr-hero-actions">
                        <a href="/shop" class="tr-btn tr-btn-primary tr-btn-lg">Ver catálogo</a>
                        <a href="/contacto-trofeos" class="tr-btn tr-btn-secondary tr-btn-lg">Solicitar cotización</a>
                    </div>
                    <div class="tr-hero-stats">
                        <div class="tr-hero-stat">
                            <div class="tr-hero-stat-n">+18</div>
                            <div class="tr-hero-stat-l">Años importando</div>
                        </div>
                        <div class="tr-hero-stat">
                            <div class="tr-hero-stat-n">+400</div>
                            <div class="tr-hero-stat-l">Modelos en stock</div>
                        </div>
                        <div class="tr-hero-stat">
                            <div class="tr-hero-stat-n">2.500</div>
                            <div class="tr-hero-stat-l">Clientes activos</div>
                        </div>
                    </div>
                </div>
                <div class="tr-hero-art">
                    <div class="tr-hero-ring tr-hero-ring-outer"></div>
                    <div class="tr-hero-ring tr-hero-ring-inner"></div>
                    <div class="tr-hero-featured">
                        <svg width="320" height="368" viewBox="0 0 200 230" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <defs>
                                <linearGradient id="tr_hero_gold" x1="0" x2="0" y1="0" y2="1">
                                    <stop offset="0%" stop-color="#fbf2d4"/>
                                    <stop offset="30%" stop-color="#e8b948"/>
                                    <stop offset="65%" stop-color="#8b6914"/>
                                    <stop offset="100%" stop-color="#d4a437"/>
                                </linearGradient>
                            </defs>
                            <path d="M70 5 L100 5 L100 14 L70 14 Z" fill="url(#tr_hero_gold)"/>
                            <path d="M100 5 L130 5 L130 14 L100 14 Z" fill="url(#tr_hero_gold)"/>
                            <path d="M55 14 H145 V72 Q145 116 100 124 Q55 116 55 72 Z" fill="url(#tr_hero_gold)" stroke="#3d2c04" stroke-width="1.5"/>
                            <path d="M55 28 Q22 30 18 58 Q22 86 55 82" fill="none" stroke="url(#tr_hero_gold)" stroke-width="9"/>
                            <path d="M145 28 Q178 30 182 58 Q178 86 145 82" fill="none" stroke="url(#tr_hero_gold)" stroke-width="9"/>
                            <rect x="85" y="124" width="30" height="14" fill="url(#tr_hero_gold)" stroke="#3d2c04" stroke-width="1.5"/>
                            <rect x="70" y="138" width="60" height="14" fill="url(#tr_hero_gold)" stroke="#3d2c04" stroke-width="1.5"/>
                            <rect x="50" y="152" width="100" height="42" fill="#1a1a1a" stroke="url(#tr_hero_gold)" stroke-width="1.5"/>
                            <rect x="58" y="160" width="84" height="10" fill="none" stroke="url(#tr_hero_gold)" stroke-width="0.8" stroke-dasharray="2 3"/>
                            <rect x="44" y="194" width="112" height="16" fill="url(#tr_hero_gold)"/>
                        </svg>
                    </div>
                </div>
            </div>
        </section>
    </template>

</odoo>
