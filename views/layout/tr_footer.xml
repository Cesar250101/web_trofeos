<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="tr_footer" inherit_id="website.layout" name="Trofeos — Footer">
        <xpath expr="//div[@id='footer']" position="replace">
            <t t-if="website.name == 'Trofeos'">
                <t t-set="tr_company" t-value="request.env.company.sudo()"/>
                <div id="footer" class="tr-footer">
                    <div class="tr-footer-inner">
                        <!-- Masthead -->
                        <div class="tr-footer-masthead">
                            <a href="/trofeos" class="tr-footer-logo">
                                <span class="tr-footer-wordmark">TROFEOS</span>
                                <span class="tr-footer-tagline">trofeos · grabado · personalización</span>
                            </a>
                            <p class="tr-footer-claim">Creamos reconocimientos que inspiran.<br/>Calidad premium para deportistas y empresas.</p>
                        </div>

                        <!-- Footer columns -->
                        <div class="tr-footer-grid">
                            <div class="tr-footer-col">
                                <h4 class="tr-footer-heading">Productos</h4>
                                <ul class="tr-footer-links">
                                    <li><a href="/shop">Todos los productos</a></li>
                                    <li><a href="/shop?category=trofeos">Trofeos</a></li>
                                    <li><a href="/shop?category=medallas">Medallas</a></li>
                                    <li><a href="/shop?category=placas">Placas</a></li>
                                    <li><a href="/shop">Grabado Láser</a></li>
                                </ul>
                            </div>
                            <div class="tr-footer-col">
                                <h4 class="tr-footer-heading">Servicios</h4>
                                <ul class="tr-footer-links">
                                    <li><a href="/servicios-trofeos">Grabado Láser</a></li>
                                    <li><a href="/servicios-trofeos">Personalización</a></li>
                                    <li><a href="/empresas-trofeos">Empresas / B2B</a></li>
                                    <li><a href="/contacto-trofeos">Cotización</a></li>
                                </ul>
                            </div>
                            <div class="tr-footer-col">
                                <h4 class="tr-footer-heading">Información</h4>
                                <ul class="tr-footer-links">
                                    <li><a href="/quienes-somos-trofeos">Quiénes somos</a></li>
                                    <li><a href="/blog">Blog / Noticias</a></li>
                                    <li><a href="/contacto-trofeos">Contacto</a></li>
                                    <li><a href="/web/login">Mi cuenta</a></li>
                                </ul>
                            </div>
                            <div class="tr-footer-col">
                                <h4 class="tr-footer-heading">Contacto</h4>
                                <ul class="tr-footer-contact">
                                    <li t-if="tr_company.street">
                                        <span class="material-symbols-outlined">location_on</span>
                                        <span>
                                            <t t-esc="tr_company.street"/>
                                            <t t-if="tr_company.city">, <t t-esc="tr_company.city"/></t>
                                        </span>
                                    </li>
                                    <li t-if="tr_company.phone">
                                        <span class="material-symbols-outlined">phone</span>
                                        <a t-att-href="'tel:' + tr_company.phone" t-esc="tr_company.phone"/>
                                    </li>
                                    <li t-if="tr_company.email">
                                        <span class="material-symbols-outlined">mail</span>
                                        <a t-att-href="'mailto:' + tr_company.email" t-esc="tr_company.email"/>
                                    </li>
                                    <li t-if="tr_company.website">
                                        <span class="material-symbols-outlined">language</span>
                                        <a t-att-href="tr_company.website" target="_blank" t-esc="tr_company.website"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Bottom bar -->
                    <div class="tr-footer-bottom">
                        <span>© <t t-esc="request.env['ir.config_parameter'].sudo().get_param('web.base.url', '')[:4]"/>
                            <t t-esc="tr_company.name"/>. Todos los derechos reservados.</span>
                        <div class="tr-footer-social">
                            <a href="#" class="tr-social-link" aria-label="Instagram">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </t>
            <t t-else="">
                <div id="footer"/>
            </t>
        </xpath>
    </template>

</odoo>
