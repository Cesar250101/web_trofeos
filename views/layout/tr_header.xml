<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="tr_header" inherit_id="website.layout" name="Trofeos — Header">
        <xpath expr="//header" position="replace">
            <t t-if="website.name == 'Trofeos'">
                <header class="tr-header" id="top">
                    <!-- Top bar -->
                    <div class="tr-topbar">
                        <div class="tr-topbar-inner container-fluid">
                            <div class="tr-topbar-left">
                                <span class="tr-topbar-item">
                                    <span class="material-symbols-outlined">local_shipping</span>
                                    Despacho 24-72 h a todo Chile
                                </span>
                                <span class="tr-topbar-item">
                                    <span class="material-symbols-outlined">verified</span>
                                    Importadores directos · Stock permanente
                                </span>
                            </div>
                            <div class="tr-topbar-right">
                                <a href="mailto:ventas@trofeospremiums.cl" class="tr-topbar-link">ventas@trofeospremiums.cl</a>
                            </div>
                        </div>
                    </div>

                    <nav class="tr-nav container-fluid">
                        <!-- Logo only (wordmark is included in the SVG logo image) -->
                        <a class="tr-logo-link" href="/trofeos" aria-label="Trofeos Home">
                            <img t-att-src="'/web/image/website/%s/logo' % website.id"
                                 class="tr-header-logo"
                                 t-att-alt="website.name"/>
                        </a>

                        <!-- Mobile toggle -->
                        <button class="tr-nav-toggle d-lg-none" data-bs-toggle="collapse" data-bs-target="#trNavMenu" aria-expanded="false" aria-label="Menú">
                            <span class="material-symbols-outlined">menu</span>
                        </button>

                        <!-- Nav links -->
                        <div class="collapse navbar-collapse tr-nav-menu" id="trNavMenu">
                            <!-- Invisible top_menu to satisfy native auto_hide_menu.js which expects a #top_menu element -->
                            <ul id="top_menu" class="d-none o_no_autohide_item"/>

                            <ul class="tr-nav-list">
                                <t t-foreach="website.menu_id.child_id" t-as="menu">
                                    <t t-if="menu.is_visible and menu.child_id">
                                        <li class="tr-nav-item tr-has-dropdown">
                                            <a t-att-href="menu.url or '#'" class="tr-nav-link tr-nav-dropdown-toggle">
                                                <t t-esc="menu.name"/>
                                                <span class="material-symbols-outlined tr-nav-chevron">expand_more</span>
                                            </a>
                                            <ul class="tr-dropdown">
                                                <t t-foreach="menu.child_id" t-as="sub">
                                                    <t t-if="sub.is_visible">
                                                        <li class="tr-dropdown-item">
                                                            <t t-if="sub.child_id">
                                                                <span class="tr-dropdown-label"><t t-esc="sub.name"/></span>
                                                                <ul class="tr-dropdown-sub">
                                                                    <t t-foreach="sub.child_id" t-as="subsub">
                                                                        <t t-if="subsub.is_visible">
                                                                            <li><a t-att-href="subsub.url" class="tr-dropdown-sub-link"><t t-esc="subsub.name"/></a></li>
                                                                        </t>
                                                                    </t>
                                                                </ul>
                                                            </t>
                                                            <t t-else="">
                                                                <a t-att-href="sub.url" class="tr-dropdown-link"><t t-esc="sub.name"/></a>
                                                            </t>
                                                        </li>
                                                    </t>
                                                </t>
                                            </ul>
                                        </li>
                                    </t>
                                    <t t-elif="menu.is_visible">
                                        <li class="tr-nav-item">
                                            <a t-att-href="menu.url" class="tr-nav-link"><t t-esc="menu.name"/></a>
                                        </li>
                                    </t>
                                </t>
                            </ul>

                            <!-- Right actions -->
                            <div class="tr-nav-actions">
                                <a href="/shop" class="tr-nav-icon" aria-label="Catálogo">
                                    <span class="material-symbols-outlined">search</span>
                                </a>
                                <a t-if="not request.env.user._is_public()" href="/web" class="tr-nav-icon" aria-label="Mi cuenta">
                                    <span class="material-symbols-outlined">person</span>
                                </a>
                                <a t-else="" href="/web/login" class="tr-nav-icon" aria-label="Iniciar sesión">
                                    <span class="material-symbols-outlined">person</span>
                                </a>
                                <a href="/contacto-trofeos" class="tr-btn tr-btn-primary tr-btn-sm">Cotizar</a>
                            </div>
                        </div>
                    </nav>
                </header>
            </t>
            <t t-else="">
                <header t-att-class="'o_header_standard' + (' o_header_hide_title' if not website.is_homepage else '')" id="top" t-ignore="True">
                    <t t-call="website.placeholder_header_brand"/>
                    <t t-call="website.placeholder_header_call_to_action"/>
                </header>
            </t>
        </xpath>
    </template>

</odoo>
